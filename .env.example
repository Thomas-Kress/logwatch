SSH_HOST=your-log-host.example.com
SSH_PORT=22
SSH_USERNAME=user
SSH_PASSWORD=
SSH_KEY_FILE=
# SSH_PASSPHRASE=
# SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Optional second Automic AE server (active-active). Leave SSH2_HOST empty for a one-server setup.
# SSH2_HOST=second-log-host.example.com
# SSH2_PORT=22
# SSH2_USERNAME=user
# SSH2_PASSWORD=
# SSH2_KEY_FILE=
# SSH2_PASSPHRASE=
# SSH2_KNOWN_HOSTS=~/.ssh/known_hosts
# SSH2_STRICT_HOST_KEY_CHECKING=accept-new

FILE_PATH=/var/log/app
FILE_PATTERN=*_00.txt

# Local Postgres (e.g. docker container pg-dev mapped to host port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Only *_log_* files are tailed; *_trc_* traces are ignored.
# Older rotations (*_01.txt, *_02.txt, ...) are added until the last 7 hours are covered.
# Days of history the header collection action will cover (default 7).
# HISTORY_COLLECTION_DAYS=7
# TAIL_LINES=200
# FILE_REFRESH_MS=15000
# File list refresh; capped at 60000 so data is never older than one minute.
# ALERT_ERROR_PER_MIN=5
# ALERT_WARN_PER_MIN=30
